{
    "name": "pushinbr/pam-skeleton",
    "description": "Production-ready starter application for the Pam runtime.",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": [
        "application",
        "pam",
        "php",
        "skeleton"
    ],
    "homepage": "https://github.com/push-in/pam",
    "support": {
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/pam-skeleton"
    },
    "require": {
        "php": "^8.5",
        "pushinbr/pam-http": "^2.0",
        "pushinbr/pam-psr": "^1.0",
        "pushinbr/pam-socket": "^1.1"
    },
    "require-dev": {
        "laravel/pint": "^1.30",
        "pushinbr/pam-testing": "^1.0",
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "pam test . --phpunit -c phpunit.xml"
    }
}
