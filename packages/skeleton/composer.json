{
    "name": "pushinbr/nimbus-skeleton",
    "description": "Starter API application for Nimbus on the PAM runtime.",
    "type": "project",
    "license": "Apache-2.0",
    "keywords": [
        "application",
        "pam",
        "php",
        "skeleton"
    ],
    "homepage": "https://github.com/push-in/pam",
    "support": {
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/nimbus-skeleton"
    },
    "require": {
        "php": "^8.5",
        "pushinbr/arcano": "^0.2.8",
        "pushinbr/nimbus": "^0.6",
        "pushinbr/pam-http-psr": "^1.0",
        "pushinbr/pam-socket": "^1.1"
    },
    "require-dev": {
        "fakerphp/faker": "^1.24",
        "laravel/pint": "^1.30",
        "phpunit/phpunit": "^12.5",
        "psy/psysh": "^0.12",
        "pushinbr/pam-http-testing": "^1.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "config": {
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "test": "pam test . --phpunit -c phpunit.xml",
        "migrate": "@php bin/migrate",
        "seed": "@php bin/migrate seed",
        "tinker": "@php bin/nimbus tinker"
    }
}
