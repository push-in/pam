{
    "name": "pushinbr/pam-testing",
    "description": "In-memory HTTP testing utilities for Pam applications.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "http",
        "pam",
        "php",
        "testing"
    ],
    "homepage": "https://github.com/push-in/pam",
