{
    "processes": {
        "http": {
            "command": ["pam", "start", "pam.php", "--workers", "2", "--admin-address", "127.0.0.1:3011"],
            "instances": 1
        },
        "queue": {
            "command": ["pam", "artisan", "queue:work", "--sleep=1", "--tries=3"],
            "instances": 1
        },
        "scheduler": {
            "command": ["pam", "artisan", "schedule:work"],
            "instances": 1
        }
    }
}
