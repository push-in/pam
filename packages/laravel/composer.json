{
    "name": "pushinbr/pam-laravel",
    "description": "Production tooling, lifecycle safety, observability and deployment for Laravel applications running on PAM.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "laravel",
        "observability",
        "pam",
        "php",
        "production"
    ],
    "homepage": "https://github.com/push-in/pam",
    "support": {
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/pam-laravel"
    },
    "require": {
        "php": "^8.4",
        "illuminate/console": "^12.0 || ^13.0",
        "illuminate/contracts": "^12.0 || ^13.0",
        "illuminate/database": "^12.0 || ^13.0",
        "illuminate/http": "^12.0 || ^13.0",
        "illuminate/support": "^12.0 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Laravel\\": "src/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pam\\Laravel\\PamServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true
    }
}
