{
    "name": "pushinbr/nimbus",
    "description": "Nimbus: the API-first PHP framework for the PAM runtime.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "api",
        "dependency-injection",
        "framework",
        "http",
        "middleware",
        "nimbus",
        "notifications",
        "openapi",
        "pam",
        "php",
        "router",
        "validation"
    ],
    "homepage": "https://github.com/push-in/nimbus",
    "support": {
        "docs": "https://github.com/push-in/nimbus#readme",
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/nimbus"
    },
    "require": {
        "php": "^8.4",
        "pushinbr/pam-contracts": "^1.1"
    },
    "suggest": {
        "ext-curl": "HTTP/2 transport of the APNs push provider and fallback HTTP client outside PAM.",
        "ext-openssl": "Signs the FCM and APNs tokens of the push notification channel.",
        "psr/http-client": "Send push and webhook notifications through any PSR-18 client (Psr18HttpClient).",
        "psr/log": "PSR-3 logging; LoggerInterface resolves to the PAM runtime structured log.",
        "pushinbr/arcano": "Required by the Arcano ORM integration (ArcanoServiceProvider, ArcanoManager).",
        "pushinbr/pam-http-psr": "PSR-7, PSR-15 and PSR-17 interoperability.",
        "pushinbr/pam-socket": "High-level event and room APIs for Pam WebSockets.",
        "symfony/mailer": "Required by the mail notification channel (Nimbus\\Notifications\\Mail\\MailChannel)."
    },
    "conflict": {
        "pushinbr/arcano": "<0.2.3"
    },
    "autoload": {
        "psr-4": {
            "Nimbus\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nimbus\\Tests\\": "tests/"
        },
        "files": [
            "tests/bootstrap.php"
        ]
    },
    "scripts": {
        "analyse": "phpstan analyse --configuration=phpstan.neon --memory-limit=1G",
        "api:compat": "bin/api-compat check",
        "docs:check": "bin/api-reference --check",
        "docs:generate": "bin/api-reference --write",
        "benchmark": "php benchmarks/router.php",
        "benchmark:check": "php benchmarks/router.php --assert",
        "test": "phpunit --configuration=phpunit.xml",
        "verify": [
            "@analyse",
            "@api:compat",
            "@docs:check",
            "@benchmark:check",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1",
        "phpunit/phpunit": "^11.5",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.1",
        "psr/http-message": "^2.0",
        "pushinbr/arcano": "^0.2.4",
        "symfony/mailer": "^7.3",
        "symfony/mime": "^7.3"
    }
}
