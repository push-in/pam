#!/usr/bin/env php
<?php

declare(strict_types=1);

// Usage: nimbus <command> [--bootstrap=bootstrap/app.php]; `nimbus list` shows the commands.
// Built-in: migrate, migrate:status, migrate:rollback, db:seed, schema:cache, schema:clear,
// schedule:list and tinker; application commands come from app/Console/Commands.

$root = getcwd() ?: '.';
$autoloaders = [
    $GLOBALS['_composer_autoload_path'] ?? null,
    $root . '/vendor/autoload.php',
    dirname(__DIR__) . '/vendor/autoload.php',
    dirname(__DIR__, 3) . '/autoload.php',
];
foreach ($autoloaders as $autoloader) {
    if (is_string($autoloader) && is_file($autoloader)) {
        require $autoloader;
        break;
    }
}
if (!class_exists(\Nimbus\Console\Tinker::class)) {
    fwrite(STDERR, "Composer dependencies are missing; run composer install.\n");
    exit(2);
}

$arguments = array_values(array_filter(is_array($argv ?? null) ? $argv : [], is_string(...)));
$command = $arguments[1] ?? 'help';
try {
    if (class_exists(\Symfony\Component\Console\Application::class)) {
        $status = \Nimbus\Console\Kernel::main($arguments, $root);
    } else {
        // Without symfony/console only tinker is available.
        $status = match ($command) {
            'tinker' => \Nimbus\Console\Tinker::main(array_slice($arguments, 2), $root),
            'help', '--help', '-h', 'list' => (static function (): int {
                fwrite(STDOUT, "Usage: nimbus tinker [--bootstrap=bootstrap/app.php] [--execute=code]\n"
                    . "Install symfony/console for migrate, db:seed, schema:cache and application commands.\n");
                return 0;
            })(),
            default => (static function () use ($command): int {
                fwrite(STDERR, "Command {$command} requires symfony/console: composer require symfony/console.\n");
                return 2;
            })(),
        };
    }
} catch (\Throwable $error) {
    fwrite(STDERR, $error->getMessage() . "\n");
    $status = 1;
}
exit($status);
