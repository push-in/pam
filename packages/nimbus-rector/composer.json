{
    "name": "pushinbr/nimbus-rector",
    "description": "Rector rules that rewrite the mechanical parts of a Laravel application for Nimbus.",
    "type": "rector-extension",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "migration",
        "nimbus",
        "pam",
        "rector"
    ],
    "homepage": "https://github.com/push-in/nimbus-rector",
    "support": {
        "docs": "https://github.com/push-in/pam/blob/main/docs/nimbus/migracao-laravel.md",
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/nimbus-rector"
    },
    "require": {
        "php": "^8.2",
        "rector/rector": "^2.2"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5"
    },
    "autoload": {
        "psr-4": {
            "Nimbus\\Rector\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Nimbus\\Rector\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true
    },
    "scripts": {
        "test": "phpunit --configuration=phpunit.xml"
    }
}
