{
    "name": "pushinbr/pam-octane",
    "description": "The elegant Laravel Octane bridge for the PAM runtime.",
    "type": "library",
    "license": "Apache-2.0",
    "keywords": [
        "laravel",
        "octane",
        "pam",
        "performance",
        "runtime"
    ],
    "homepage": "https://github.com/push-in/pam-octane",
    "support": {
        "issues": "https://github.com/push-in/pam/issues",
        "source": "https://github.com/push-in/pam-octane"
    },
    "require": {
        "php": "^8.4",
        "laravel/octane": "^2.19",
        "pushinbr/pam-core-api": "^1.0"
    },
    "require-dev": {
        "orchestra/testbench": "^10.0|^11.0",
        "phpstan/phpstan": "^2.2",
        "phpunit/phpunit": "^12.5|^13.0"
    },
    "autoload": {
        "psr-4": {
            "Pam\\Octane\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Pam\\Octane\\Tests\\": "tests/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Pam\\Octane\\PamOctaneServiceProvider"
            ]
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": false
        },
        "platform-check": true,
        "sort-packages": true
    },
    "scripts": {
        "analyse": "phpstan analyse --no-progress",
        "test": "phpunit --colors=always",
        "verify": [
            "@analyse",
            "@test"
        ]
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
