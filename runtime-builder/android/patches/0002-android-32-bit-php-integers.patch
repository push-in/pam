 /* Integer types. */
 #ifdef ZEND_ENABLE_ZVAL_LONG64
+# if defined(__ANDROID__) && defined(__i386__)
+/* PAM: i386 aligns 64-bit struct members to 4 bytes. Zend needs 8, as ARMv7
