+#elif defined(__ANDROID__)
+/* PAM: 32-bit Android (armeabi-v7a, x86) keeps 64-bit PHP integers, like the
+ * x32 ABI does: PHP_INT_SIZE is 8 on every PAM Android runtime, so PHP code
+ * and the native bridge see the same integers on all ABIs. */
+# define ZEND_ENABLE_ZVAL_LONG64 1
