+ * closure variables keep flags in the low 3 bits of a Bucket byte offset. */
+typedef int64_t zend_long __attribute__((aligned(8)));
+typedef uint64_t zend_ulong __attribute__((aligned(8)));
+# else
 typedef int64_t zend_long;
 typedef uint64_t zend_ulong;
+# endif
