parameters:
    level: 9
    ignoreErrors:
        -
            identifier: trait.unused
    scanFiles:
        - native-shared-stubs.php
    excludePaths:
        analyse:
            - ../../runtime/laravel.php
    paths:
        - ../../runtime
        - ../../packages/contracts/src
        - ../../packages/nimbus/src
        - ../../packages/socket/src
        - ../../packages/http-psr/src
        - ../../packages/http-testing/src
        - src
        - tests/ProbeTest.php
        - tests/HttpClientSecurityTest.php
        - tests/ApiTest.php
