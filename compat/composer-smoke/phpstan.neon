parameters:
    level: 9
    ignoreErrors:
        -
            identifier: trait.unused
        -
            # pusher/pusher-php-server needs Guzzle 7; this fixture installs Guzzle 8.
            identifier: class.notFound
            path: ../../packages/nimbus/src/Broadcasting/PusherBroadcaster.php
    scanFiles:
        - native-shared-stubs.php
        - ../../packages/nimbus/phpstan/stubs/pam-pg.php
    excludePaths:
        analyse:
            - ../../runtime/laravel.php
    paths:
        - ../../runtime
        - ../../packages/contracts/src
        - ../../packages/nimbus/src
        - ../../packages/socket/src
        - ../../packages/http-psr/src
        - ../../packages/http-testing/src
        - src
        - tests/ProbeTest.php
        - tests/HttpClientSecurityTest.php
        - tests/ApiTest.php
