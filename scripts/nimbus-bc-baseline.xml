<?xml version="1.0" encoding="UTF-8"?>
<!--
  Accepted breaks of packages/nimbus against the last released tag, read by
  scripts/nimbus-bc-check.sh (copied as .roave-backward-compatibility-check.xml).
  Only 0.x releases may add entries, and each entry is listed in CHANGELOG.md.
  Empty this file after the release that ships them is tagged. From 1.0 on, a break
  waits for the next major (packages/nimbus/docs/VERSIONING.md).
-->
<roave-bc-check>
    <baseline>
        <!-- 0.7: implementation classes marked @internal (not documented, not in a public signature). -->
        <ignored-regex>#Nimbus\\(CallableRequestHandler|ContainerMiddleware|ControllerHandler|HandlerResolver|Pipeline|PackageDiscovery|View\\Compiler|View\\CompiledTemplate|Validation\\DtoHydrator) was marked "@internal"#</ignored-regex>
    </baseline>
</roave-bc-check>
