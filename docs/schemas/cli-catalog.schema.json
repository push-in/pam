{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pamphp.dev/schemas/cli-catalog.schema.json",
  "title": "PAM CLI catalog",
  "description": "Machine-readable command discovery emitted by pam catalog --json. Group codes are append-only sequential integers.",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "commands"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "commands": {
      "type": "array",
      "minItems": 1,
      "maxItems": 128,
      "uniqueItems": true,
      "items": { "$ref": "#/$defs/command" }
    }
  },
  "$defs": {
    "command": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "summary", "groupCode", "groupLabel", "supportsJson"],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 96,
          "pattern": "^[a-z][a-z0-9-]*(?::[a-z][a-z0-9-]*)*$"
        },
        "summary": { "type": "string", "minLength": 1, "maxLength": 160 },
        "groupCode": {
          "type": "integer",
          "enum": [1, 2, 3, 4, 5, 6, 7, 8, 9]
        },
        "groupLabel": {
          "type": "string",
          "enum": ["Project", "Develop", "Generate", "Ecosystem", "Quality", "Ship", "Runtime", "Observe", "Advanced"]
        },
        "supportsJson": { "type": "boolean" }
      }
    }
  }
}
