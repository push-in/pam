{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://pam.dev/schemas/desktop-host-doctor.schema.json",
  "title": "PAM Desktop host diagnostic report",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "surfaceCode", "resultCode", "sourceCode", "authenticated", "binary", "checks", "remediation", "verificationCommand"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "surfaceCode": { "const": 3 },
    "resultCode": { "type": "integer", "enum": [1, 2], "description": "1 verified, 2 needs attention." },
    "sourceCode": { "type": "integer", "enum": [1, 2, 3, 4], "description": "1 signed registry, 2 explicit PAM_DESKTOP_BINARY, 3 sibling binary, 4 PATH lookup." },
    "authenticated": { "type": "boolean" },
    "binary": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "checks": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "prefixItems": [
        { "$ref": "#/$defs/provenanceCheck" },
        { "$ref": "#/$defs/digestCheck" },
        { "$ref": "#/$defs/identityCheck" }
      ],
      "items": false
    },
    "remediation": { "type": "string", "minLength": 1, "maxLength": 512 },
    "verificationCommand": { "const": "pam desktop host:doctor . --json" }
  },
  "$defs": {
    "check": {
      "type": "object",
      "additionalProperties": false,
      "required": ["checkCode", "resultCode"],
      "properties": {
        "checkCode": { "type": "integer" },
        "resultCode": { "type": "integer", "enum": [1, 2], "description": "1 passed, 2 failed." }
      }
    },
    "provenanceCheck": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "checkCode": { "const": 1 } } }] },
    "digestCheck": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "checkCode": { "const": 2 } } }] },
    "identityCheck": { "allOf": [{ "$ref": "#/$defs/check" }, { "properties": { "checkCode": { "const": 3 } } }] }
  },
  "allOf": [
    {
      "if": { "properties": { "authenticated": { "const": true } }, "required": ["authenticated"] },
      "then": {
        "properties": {
          "resultCode": { "const": 1 },
          "sourceCode": { "const": 1 },
          "checks": {
            "contains": { "properties": { "resultCode": { "const": 2 } }, "required": ["resultCode"] },
            "minContains": 0,
            "maxContains": 0
          }
        }
      }
    },
    {
      "if": { "properties": { "authenticated": { "const": false } }, "required": ["authenticated"] },
      "then": { "properties": { "resultCode": { "const": 2 } } }
    }
  ]
}
